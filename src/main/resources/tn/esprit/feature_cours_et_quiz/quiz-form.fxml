<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="tn.esprit.controllers.feature_cours_et_quiz.QuizFormController"
    prefWidth="1100.0" prefHeight="700.0"
    stylesheets="@app.css,@quiz-form.css"
    styleClass="page-root sp-bg">

    <VBox styleClass="welcome-banner">
        <Label fx:id="titleLabel" text="➕ Nouveau Quiz" styleClass="welcome-title"/>
        <Label text="Contrôle de saisie: titre (min 3), durée > 0. La matière est choisie depuis la page Matières." styleClass="welcome-desc"/>
        <Label fx:id="matiereContextLabel" text="Matière: sélectionnez une matière d'abord." styleClass="sp-card-meta"/>
    </VBox>

    <Label fx:id="errorLabel" text="" styleClass="error-inline"/>

    <VBox spacing="20" styleClass="sp-card">
        <VBox spacing="8">
            <Label text="Titre du Quiz" styleClass="sp-card-title"/>
            <TextField fx:id="titreField" promptText="Ex: Introduction au Java"/>
        </VBox>

        <VBox spacing="8">
            <HBox spacing="10" alignment="CENTER_LEFT">
                <Label text="Contenu pédagogique" styleClass="sp-card-title"/>
                <HBox HBox.hgrow="ALWAYS"/>
                <Button fx:id="aiGenBtn" text="🤖 Générer QCM avec IA" onAction="#handleAiGenerate" styleClass="sp-btn sp-btn-secondary"/>
            </HBox>
            <TextArea fx:id="contenuField" promptText="Saisissez le texte du cours pour que l'IA puisse générer des questions Vrai/Faux." prefHeight="150"/>
        </VBox>

        <VBox spacing="8">
            <Label text="Durée (minutes)" styleClass="sp-card-title"/>
            <TextField fx:id="dureeField" promptText="Ex: 30"/>
        </VBox>
    </VBox>

    <HBox spacing="15">
        <Button text="Annuler" onAction="#handleCancel" styleClass="sp-btn sp-btn-secondary"/>
        <Button text="🚀 Enregistrer le Quiz" onAction="#handleSave" styleClass="sp-btn sp-btn-primary"/>
    </HBox>
</VBox>
