<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="tn.esprit.controllers.feature_cours_et_quiz.MatiereCoursController"
      spacing="14"
    prefWidth="1100.0" prefHeight="700.0"
    stylesheets="@app.css,@matiere-cours.css"
    styleClass="page-root sp-bg">

    <HBox spacing="12">
        <Button text="← Retour" onAction="#handleBack" styleClass="sp-btn sp-btn-secondary"/>
        <VBox spacing="2">
            <Label fx:id="matiereTitle" text="📖 Cours" styleClass="section-title"/>
            <Label text="Sélectionnez une leçon pour lire son contenu." styleClass="sp-card-meta"/>
        </VBox>
    </HBox>

    <Label fx:id="errorLabel" text="" styleClass="error-inline"/>

    <HBox spacing="16" VBox.vgrow="ALWAYS">
        <VBox spacing="10" prefWidth="320" styleClass="sp-card">
            <Label text="Leçons" styleClass="sp-card-title"/>

            <VBox fx:id="pdfDropZone" styleClass="sp-dropzone">
                <Label text="📄 Ajouter un cours (PDF)" styleClass="sp-card-title"/>
                <Label text="Glissez-déposez un fichier .pdf ici." styleClass="sp-card-meta" wrapText="true"/>
            </VBox>

            <ListView fx:id="leconsList" VBox.vgrow="ALWAYS"/>
        </VBox>

        <VBox spacing="10" HBox.hgrow="ALWAYS" styleClass="sp-card">
            <HBox spacing="10" alignment="CENTER_LEFT">
                <Label text="Contenu du cours" styleClass="sp-card-title"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button fx:id="openPdfBtn" text="Ouvrir PDF" onAction="#handleOpenPdf" styleClass="sp-btn sp-btn-secondary"/>
            </HBox>

            <TextArea fx:id="contenuArea" editable="false" wrapText="true" VBox.vgrow="ALWAYS"/>

            <!-- Rating Section -->
            <HBox fx:id="ratingBox" spacing="15" alignment="CENTER_LEFT" style="-fx-padding: 10; -fx-background-color: rgba(255,255,255,0.05); -fx-background-radius: 10;">
                <Label text="Évaluez ce cours :" styleClass="form-label"/>
                <HBox fx:id="starsContainer" spacing="5">
                    <!-- Stars will be injected here via code or just Labels -->
                    <Label text="⭐" onMouseClicked="#handleRate1" style="-fx-cursor: hand; -fx-font-size: 20;"/>
                    <Label text="⭐" onMouseClicked="#handleRate2" style="-fx-cursor: hand; -fx-font-size: 20;"/>
                    <Label text="⭐" onMouseClicked="#handleRate3" style="-fx-cursor: hand; -fx-font-size: 20;"/>
                    <Label text="⭐" onMouseClicked="#handleRate4" style="-fx-cursor: hand; -fx-font-size: 20;"/>
                    <Label text="⭐" onMouseClicked="#handleRate5" style="-fx-cursor: hand; -fx-font-size: 20;"/>
                </HBox>
                <Region HBox.hgrow="ALWAYS"/>
                <Label fx:id="avgRatingLabel" text="Moyenne: --/5" styleClass="sp-card-meta"/>
            </HBox>
        </VBox>
    </HBox>

</VBox>
